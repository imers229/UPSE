    {
        "id": "tempFn",
        "type": "function",
        "z": "b1c2d3e4f5a6b7c8",
        "name": "Calcular Temperatura",
        "func": "\nmsg.sensor = \"temperatura\";\nmsg.valor = msg.payload * 10;         \nmsg.payload = `${msg.valor.toFixed(2)} °C`; \nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 80,
        "wires": [
            [
                "alarmTemp",
                "debugAlarmTemp"
            ]
        ]
    },
    {
        "id": "humFn",
        "type": "function",
        "z": "b1c2d3e4f5a6b7c8",
        "name": "Calcular Humedad",
        "func": "\nmsg.sensor = \"humedad\";\nmsg.valor = msg.payload * 3 + 2.5;                  \nmsg.payload = `${msg.valor.toFixed(2)} %`;        \nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 240,
        "wires": [
            [
                "alarmHum",
                "debugAlarmHum"
            ]
        ]
    },
    {
        "id": "alarmTemp",
        "type": "function",
        "z": "b1c2d3e4f5a6b7c8",
        "name": "Alarma Temp > 50",
        "func": "\nconst valor = msg.valor ?? parseFloat(msg.payload);\n\nif (valor > 50) {\n    msg.payload = \"Alarma mayor a 50 °C\";\n    msg.valor = `${valor.toFixed(2)} °C`;\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 850,
        "y": 120,
        "wires": [
            [
                "debugAlarmTemp"
            ]
        ]
    },
    {
        "id": "alarmHum",
        "type": "function",
        "z": "b1c2d3e4f5a6b7c8",
        "name": "Alarma Hum > 90",
        "func": "const valor = msg.valor ?? parseFloat(msg.payload);\n\nif (valor > 90) {\n    msg.payload = \"Alarma mayor a 90 %\";\n    msg.valor = `${valor.toFixed(2)} %`;\n    return msg;\n}\n\nreturn null;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 850,
